    {
        "id": "fn_telegramcmd_final",
        "type": "function",
        "z": "tab_final",
        "name": "Handle /status /location",
        "func": "var delivery = flow.get('delivery') || {};\nvar incomingChatId = msg.payload && msg.payload.chatId;\nvar text = ((msg.payload && msg.payload.content) || \"\").toString().trim().toLowerCase();\n\nif (text === \"/status\") {\n    msg.payload = {\n        chatId: incomingChatId || \"PUT_YOUR_TELEGRAM_CHAT_ID_HERE\",\n        type: \"message\",\n        content: \"\\ud83d\\udce6 PACKAGE_102\\nStatus: \" + (delivery.status || \"UNKNOWN\") +\n                  \"\\nDriver: \" + (delivery.driverName || \"N/A\") +\n                  \"\\nLock: \" + (delivery.lockState || \"UNKNOWN\") +\n                  \"\\nPackage Present: \" + (delivery.irPresent ? \"YES\" : \"NO\") +\n                  \"\\nUnauthorized Attempts: \" + (delivery.unauthorizedAttempts || 0)\n    };\n    return msg;\n}\nif (text === \"/location\") {\n    var locText;\n    if (delivery.currentLocation) {\n        locText = \"\\ud83d\\udccd Current Location:\\nLat: \" + delivery.currentLocation.lat +\n                  \"\\nLon: \" + delivery.currentLocation.lon;\n    } else {\n        locText = \"Location not available yet.\";\n    }\n    msg.payload = { chatId: incomingChatId || \"PUT_YOUR_TELEGRAM_CHAT_ID_HERE\", type: \"message\", content: locText };\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0, "initialize": "", "finalize": "", "libs": [],
        "x": 420, "y": 420,

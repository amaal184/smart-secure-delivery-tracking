    {
        "id": "fn_eventhandler_final",
        "type": "function",
        "z": "tab_final",
        "name": "Route Event -> Telegram/Email",
        "func": "var delivery = flow.get('delivery') || {};\nvar ev = msg.payload;\n\nvar icons = {\n    DRIVER_ACCESS: \"\\ud83d\\udd13\",\n    PACKAGE_LOADED: \"\\ud83d\\udce6\",\n    LOCKED_IN_TRANSIT: \"\\ud83d\\udd12\",\n    OPENED_WITHOUT_LOADING: \"\\u26a0\\ufe0f\",\n    UNAUTHORIZED_ACCESS: \"\\ud83d\\udea8\",\n    PACKAGE_MISSING: \"\\ud83d\\udea8\"\n};\nvar icon = icons[ev.type] || \"\\u2139\\ufe0f\";\n\nvar outTelegram = {\n    payload: {\n        chatId: \"PUT_YOUR_TELEGRAM_CHAT_ID_HERE\",\n        type: \"message\",\n        content: icon + \" \" + ev.type + \"\\n\" + ev.message\n    }\n};\n\nvar outEmail = null;\n\nif (ev.type === \"OPENED_WITHOUT_LOADING\") {\n    outEmail = { topic: \"CRITICAL: Compartment Opened Without Loading - PACKAGE_102\", payload: ev.message };\n}\nelse if (ev.type === \"PACKAGE_MISSING\") {\n    outEmail = { topic: \"CRITICAL: Package Missing - PACKAGE_102\", payload: ev.message };\n}\nelse if (ev.type === \"UNAUTHORIZED_ACCESS\") {\n    if ((delivery.unauthorizedAttempts || 0) >= 3) {\n        outEmail = {\n            topic: \"CRITICAL: Repeated Unauthorized Access - PACKAGE_102\",\n            payload: ev.message\n        };\n    }\n}\n\nreturn [outTelegram, outEmail];",
        "outputs": 2,
        "noerr": 0, "initialize": "", "finalize": "", "libs": [],
        "x": 430, "y": 180,
        "wires": [["tg_sender_final"], ["email_alert_final"]]
    },

    {
        "id": "mqttin_location_final",
        "type": "mqtt in",
        "z": "tab_final",
        "name": "OwnTracks Location",
        "topic": "owntracks/PUT_YOUR_USERNAME_HERE/PUT_YOUR_DEVICE_ID_HERE",
        "qos": "1", "datatype": "json",
        "broker": "broker_final",
        "x": 160, "y": 260,
        "wires": [["fn_geofence_final", "fn_worldmapformat_final"]]
    },
    {
        "id": "fn_geofence_final",
        "type": "function",
        "z": "tab_final",
        "name": "Geofence Check",
        "func": "var delivery = flow.get('delivery');\nif (!delivery) return null;\n\nvar lat = msg.payload.lat;\nvar lon = msg.payload.lon;\nvar acc = msg.payload.acc;\nif (lat === undefined || lon === undefined) return null;\n\n// تجاهل أي قراءة GPS دقتها ضعيفة (أكتر من 30 متر)\nif (acc !== undefined && acc > 30) {\n    node.warn(\"Ignored low-accuracy GPS reading: \" + acc + \"m\");\n    return null;\n}\n\ndelivery.currentLocation = { lat: lat, lon: lon };\ndelivery.locationHistory = delivery.locationHistory || [];\ndelivery.locationHistory.push({ lat: lat, lon: lon, t: Date.now() });\nif (delivery.locationHistory.length > 100) delivery.locationHistory.shift();\n\nfunction distanceMeters(lat1, lon1, lat2, lon2) {\n    var R = 6371000;\n    function toRad(d) { return d * Math.PI / 180; }\n    var dLat = toRad(lat2 - lat1);\n    var dLon = toRad(lon2 - lon1);\n    var a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(toRad(lat1))*Math.cos(toRad(lat2))*Math.sin(dLon/2)*Math.sin(dLon/2);\n    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));\n}\n\nvar dest = delivery.destination;\nvar dist = distanceMeters(lat, lon, dest.lat, dest.lon);\ndelivery.distanceToDestination = Math.round(dist);\n\nvar outTelegram = null;\nvar outEmail = null;\n\nif (dist <= delivery.geofenceRadius) {\n    if (delivery.status === \"IN_TRANSIT\") {\n        delivery.status = \"ARRIVED\";\n        outTelegram = {\n            payload: {\n                chatId: \"PUT_YOUR_TELEGRAM_CHAT_ID_HERE\",\n                type: \"message\",\n                content: \"\\ud83d\\udce6 PACKAGE_102 has ARRIVED at destination!\\nDistance: \" + Math.round(dist) + \"m\"\n            }\n        };\n    }\n} else if (delivery.status === \"IN_TRANSIT\" && dist > (delivery.geofenceRadius * 20) && !delivery.routeDeviationAlerted) {\n    delivery.routeDeviationAlerted = true;\n    outTelegram = {\n        payload: {\n            chatId: \"PUT_YOUR_TELEGRAM_CHAT_ID_HERE\",\n            type: \"message\",\n            content: \"\\u26a0\\ufe0f ROUTE DEVIATION detected.\\nDistance: \" + Math.round(dist) + \"m\"\n        }\n    };\n    outEmail = { topic: \"CRITICAL: Serious Route Deviation - PACKAGE_102\", payload: \"Deviation distance: \" + Math.round(dist) + \"m\" };\n}\n\nflow.set('delivery', delivery);\nreturn [outTelegram, outEmail, { payload: delivery }];",
        "outputs": 3,
        "noerr": 0, "initialize": "", "finalize": "", "libs": [],
        "x": 420, "y": 300,
        "wires": [["tg_sender_final"], ["email_alert_final"], ["ui_dashboard_final"]]
    },
    {
        "id": "fn_worldmapformat_final",
        "type": "function",
        "z": "tab_final",
        "name": "Format for Worldmap",
        "func": "var delivery = flow.get('delivery');\nif (!delivery) return null;\n\nvar lat = msg.payload.lat;\nvar lon = msg.payload.lon;\nif (lat === undefined || lon === undefined) return null;\n\nvar routeLine = (delivery.locationHistory || []).map(function (p) {\n    return [p.lat, p.lon];\n});\n\nvar currentPoint = { name: \"PACKAGE_102\", lat: lat, lon: lon, icon: \"truck\", layer: \"Shipment\" };\nvar route = { name: \"Shipment Route\", line: routeLine, layer: \"Route\" };\nvar destinationMarker = { name: \"Destination\", lat: delivery.destination.lat, lon: delivery.destination.lon, icon: \"flag\", layer: \"Destination\" };\n\nmsg.payload = [currentPoint, route, destinationMarker];\nreturn msg;",
        "outputs": 1,
        "noerr": 0, "initialize": "", "finalize": "", "libs": [],
        "x": 420, "y": 260,
        "wires": [["worldmap_final"]]
    },
